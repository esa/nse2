# Public hostname or IP address of the machine running the external
# WireGuard server. The client uses this to establish the tunnel.
SERVER_URL=host.docker.internal

# Host port exposed for WireGuard traffic (must match server compose).
SERVER_PORT=51820

# WireGuard tunnel address of the external application container.
# The application shares the server's network namespace, so this is
# the server's wg0 IP (e.g. 10.192.122.1). Traffic forwarded by the
# client's iptables DNAT rules is sent to this address.
APPLICATION_IP=10.192.122.1
